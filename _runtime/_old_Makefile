
DUSK_FLAGS =

IFLAGS = -I./sys
LDFLAGS = -L./sys

runtime.exe: FORCE
	x86_64-w64-mingw32-gcc -o runtime.exe dep/glad.c runtime.c $(DUSK_FLAGS) $(IFLAGS) $(LDFLAGS) -pthread

main.exe: FORCE
	x86_64-w64-mingw32-gcc -o main.exe runtime.c j_out.o -DAPP $(DUSK_FLAGS) $(IFLAGS) $(LDFLAGS) -pthread

main: FORCE
	gcc -o main runtime.c j_out.o $(DUSK_FLAGS) $(IFLAGS) $(LDFLAGS) -pthread

FORCE: ;