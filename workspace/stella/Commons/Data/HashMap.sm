	(*
		default hash/equality functions
	*)


fn stringHash(String bytes) U64
	var hash = 0xcbf29ce484222325_L
	for i < |bytes| do
		hash = hash ^ toU64(bytes[0])
		hash = hash * 0x100000001b3_L
	end
	return hash
end

fn stringEquals(String e1, String e2) Bool
	return e1 = e2
end
