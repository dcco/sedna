	return l.next((0, -1))
end*)

fn lookup(OrderList[T] l, (Int, Int) i) T
	return l.data[i.1][i.2]
end

fn insert(OrderList[T] l, T obj)
	l.data[l..f(obj)] += obj
end

fn find(OrderList[T] l, T obj) (Int, Int)
	var a = l.data[l..f(obj)]
	for i < |a| do
		if a[i].oid = obj.oid then return (l..f(obj), i) end
	end
	return (l..f(obj), -1)
end

fn remove(OrderList[T] l, T obj)
	var (a, b) = l.find(obj)
	l.data[a] /= b
end