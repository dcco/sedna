
struct OrderList[T]{
	1d[1d[T]] data,
	Int max,
	Fn(T) Int f
}

fn newOrderList(Int max, Fn(T) Int f) OrderList[T]
	var data = new 1d(max)[.. new 1d[~T]]
	return new OrderList{
		data = data,
		max = max,
		f = f
	}
end

fn clear(OrderList[T] l)
	for i < |l.data| do
		l.data[i].clear()
	end
end

fn flatten(OrderList[T] l, 1d[T] dst) 1d[T]
	dst.clear()
	for i < |l.data| do
		for j < |l.data[i]| do
			dst += l.data[i][j]
		end
	end
	return dst
end

fn flattenRev(OrderList[T] l, 1d[T] dst) 1d[T]
	dst.clear()
	var i = |l.data| - 1
	while i > -1 do
		var j = |l.data[i]| - 1
		while j > -1 do
			dst += l.data[i][j]
			j = j - 1
		end
		i = i - 1
	end
	return dst
end

