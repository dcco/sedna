
enum ToolMode = StartTM | PencilTM | FillTM

struct ToolModeRef{
	ToolMode mode
}

struct EState{
	Room roomRef,
	-- painting status
	ToolMode mode,
	TType selTT,
	-- draft map
	(Int, Int) draftPos
}

fn newEState(Room room) EState
	return new EState{
		roomRef = room,
		mode = PencilTM,
		selTT = GrassTT,
		draftPos = (0, 0)
	}
end