
	(* special elements: *)

	(* - action display *)

const _CALC_DARK = 0x1B2921FF
const _CALC_LIGHT = 0x76B592FF

fn drawActDisplay(EState cont, ElemState state)
	drawBox(_CALC_DARK, 0, 0, state.width, state.height)
	if cont.actTime > 0 then
		drawText(cont.actText, _CALC_LIGHT, 2, 2)
	else
		drawText("-", _CALC_LIGHT, 2, 2)
	end
end

fn newActDisplay(Int x, Int y) Elem[EState]
	return new Elem{
		size = (x, y),
		params = new 1d[~XPtr],
		press = nopClick,
		release = nopClick,
		draw = drawActDisplay
	}
end

	(* special [mode select] image button *)

fn clickSetMode(EState cont, ElemState state, Int x, Int y)
	var ref = fromAnonPtr(~ModeRef, state.params[1])
	match ref
	case ToolModeRef do
		cont.toolMode = ref.mode
	case PalModeRef do
		cont.palMode = ref.mode
	end
end

fn drawImageButton(EState cont, ElemState state)
	var modeRef = fromAnonPtr(~ModeRef, state.params[1])
	-- get mode status
	var subFrame = 0
	match modeRef
	case ToolModeRef do
		if modeRef.mode.i = cont.toolMode.i then subFrame = 1 end
	case PalModeRef do
		if modeRef.mode.i = cont.palMode.i then subFrame = 1 end
	end
	-- draw image + frame
	var sRef = fromAnonPtr(~SpriteRef, state.params[0])
	var sprite = GS.iMap.spriteStore[sRef.sDef.i]
	if sprite is null then return end
	var frame = sRef.frame
	drawSprite(0, 0, sprite, frame + subFrame, false)
end

fn newImageButton(SpriteDef sDef, Int frame, ModeRef ref, Int w, Int h) Elem[EState]
	var sRef = new SpriteRef{
		sDef = sDef,
		frame = frame
	}
	return new Elem{
		size = (w, h),
		params = new 1d[toAnonPtr(sRef), toAnonPtr(ref)],
		press = clickSetMode,
		release = nopClick,
		draw = drawImageButton
	}
end

	(* - draft map *)

fn drawDraftPane(EState cont, ElemState state)
	var sprite = GS.iMap.spriteStore[DraftTset.i]
	if sprite is null then return end
	-- calculate draft dimensions
	var (cx, cy) = cont.draftPos
	var tw = pixelTile(state.width)
	var th = pixelTile(state.height)
	var sx = cx - tw / 2
	var sy = cy - th / 2
	-- draw tiles
	var room = cont.roomRef
	for i < tw, j < th do
		var xx = sx + i
		var yy = sy + j
		var (sector, _, _) = room.data.lookupSector(xx, yy)
		-- draft frame
		var frame = 0
		if sector isnt null then
			if !sector.memFlag then frame = 1
			elsif sector.emptyFlag then frame = 4
			elsif sector.dirtyFlag then frame = 3
			else frame = 2 end
		end
		if xx = cx && yy = cy then frame = frame + 5 end
		drawSprite(tilePixel(i), tilePixel(j), sprite, frame, false)
	end
end

fn newDraftPane(Int w, Int h) Elem[EState]
	return new Elem{
		size = (w, h),
		params = new 1d[~XPtr],
		press = nopClick,
		release = nopClick,
		draw = drawDraftPane
	}
end

	(* save/load hooks *)

fn saveAct(EState cont, ElemState state, Int x, Int y)
	cont.roomRef.save()
	cont.actText = "SAVED"
	cont.actTime = 180
end

	(* tool bar *)

fn toolbar(Int canvasWidth) Layout[EState]
	var toolsetPane = vertElems(new 1d[
		newImageButton(Toolset, 0, tmRef(StartTM), _TPX, _TPX),
		newImageButton(Toolset, 2, tmRef(PencilTM), _TPX, _TPX),
		newImageButton(Toolset, 4, tmRef(FillTM), _TPX, _TPX)
	], 2)
	var palModePane = horizElems(new 1d[
		newImageButton(Toolset, 10, pmRef(ForePM), _TPX, _TPX),
		newImageButton(Toolset, 12, pmRef(BackPM), _TPX, _TPX),
		newImageButton(Toolset, 14, pmRef(ObjPM), _TPX, _TPX)
	], 2)
	var tilesetPane = vertGroup(new 1d[
		palModePane,
		singleGroup(newTilePal(8, 4)),
		singleGroup(newTileSel())
	], 4)
	var subSavePane = horizElems(new 1d[
		newButton("SAVE", tilePixel(3), tilePixel(1), saveAct),
		newActDisplay(tilePixel(4), tilePixel(1))
	], 4)
	var savePane = vertGroup(new 1d[
		singleGroup(newDraftPane(tilePixel(13), tilePixel(6))),
		subSavePane
	], 4)
	var layout = horizGroup(new 1d[toolsetPane, tilesetPane, savePane], 8)
	layout.backFlag = true
	layout.padding = 8
	layout.minSize = (canvasWidth, 85)
	return layout
end
