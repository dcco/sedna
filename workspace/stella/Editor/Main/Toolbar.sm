	(* tool bar *)

fn toolbar(Int canvasWidth) Layout[EState]
	var toolsetPane = vertElems(new 1d[
		newImageButton(Toolset, 0, StartTM, _TPX, _TPX),
		newImageButton(Toolset, 2, PencilTM, _TPX, _TPX),
		newImageButton(Toolset, 4, FillTM, _TPX, _TPX)
	], 2)
	var tilesetPane = vertElems(new 1d[
		newTilePal(8, 4),
		newTileSel()
	], 4)
	var layout = horizGroup(new 1d[toolsetPane, tilesetPane], 6)
	layout.backFlag = true
	layout.padding = 8
	layout.minSize = (canvasWidth, 85)
	return layout
end