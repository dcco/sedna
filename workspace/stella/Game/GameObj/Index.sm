
enum ObjType attrs{ MType mType, PushType pushType } =
	PLAYER{ MAcc, PushDef }
	| BLOCK1{ MBlock, PushBlock1 }
	| BLOCK2{ MBlock, PushBlock2 }

enum ObjDef attrs{ (Int, Int) size, ObjType oType, SpriteDef sDef, ObjState iState } =
	MayObj{ (3, 7), PLAYER, MaySp, new SimpState{ act = PCAct } }
	| BigBoxObj{ (16, 16), BLOCK2, BigBoxSp, new SimpState{ act = BounceAct } }