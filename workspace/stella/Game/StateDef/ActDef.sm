
fn idleUpdate(GameObj self)
	var wall = self.body.wall
	if wall.bot then
		self.body.xspd = 0
	end
end

fn bounceUpdate(GameObj self)
	var wall = self.body.wall
	if wall.obstruct && wall.left then self.body.xspd = +0x200
	elsif wall.obstruct && wall.right then self.body.xspd = -0x200
	elsif self.body.xspd = 0 then self.body.xspd = +0x200 end
end

fn doAct(ObjAct act, GameObj self)
	match act
	case BounceAct do
		self.bounceUpdate()
	case PCAct do
	case IdleAct do
		self.idleUpdate()
	owise
		panic("ActDef.sm - Unsupported action.")
	end
end

