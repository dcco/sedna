
	(*
		individual sector
	*)

const _SEC_SIZE = 64

struct Sector[T]{
	Bool memFlag,
	Bool emptyFlag,
	Bool dirtyFlag,
	2d[T?] data
}

	(*
		endless grid
		- made up of individual sectors, 
	*)

struct EndlessGrid[T]{
	Int secX,
	Int secY,
	2d[Sector[T]?] sectors
}

fn newEndlessGrid(TYPE[T]) EndlessGrid[T]
	var _s = new 2d(5, 5)[~Sector[T]?]
	return new EndlessGrid{
		secX = -2,
		secY = -2,
		sectors = _s
	}
end

fn lookupSector(EndlessGrid[T] grid, Int sx, Int sy) (Sector[T]?, Int, Int)
	var tsx = sx - grid.secX
	var tsy = sy - grid.secY
	var (sw, sh) = |grid.sectors|
	if tsx < 0 || tsy < 0 || tsx >= sw || tsy >= sh then
		return (null, tsx, tsy)
	end
	return (grid.sectors[tsx, tsy], tsx, tsy)
end

fn lookup(EndlessGrid[T] grid, Int x, Int y) T?
	var (sector, _, _) = grid.lookupSector(adiv(x, _SEC_SIZE), adiv(y, _SEC_SIZE))
	if sector is null then return null end
	return sector.data[amod(x, _SEC_SIZE), amod(y, _SEC_SIZE)]
end

fn update(EndlessGrid[T] grid, T tile, Int x, Int y)
	(*var tsx = adiv(x, _SEC_SIZE) - grid.secX
	var tsy = adiv(y, _SEC_SIZE) - grid.secY
	var (sw, sh) = |grid.sectors|
	if tsx < 0 || tsy < 0 || tsx >= sw || tsy >= sh then
		-- TODO: decide how we want "extension" to go
		return
	end*)
	var (sector, tsx, tsy) = grid.lookupSector(adiv(x, _SEC_SIZE), adiv(y, _SEC_SIZE)) --grid.sectors[tsx, tsy]
	if sector is null then
		var _data = new 2d(_SEC_SIZE, _SEC_SIZE)[~T?]
		sector = new Sector{ memFlag = false, emptyFlag = false, dirtyFlag = true, data = _data }
		grid.sectors[tsx, tsy] = sector
	end
	sector.data[amod(x, _SEC_SIZE), amod(y, _SEC_SIZE)] = tile
	sector.emptyFlag = false
	sector.dirtyFlag = true
end

fn updateEmpty(EndlessGrid[T] grid, Int x, Int y)
	var (sector, tsx, tsy) = grid.lookupSector(adiv(x, _SEC_SIZE), adiv(y, _SEC_SIZE))
	if sector is null then return end
	var emptyFlag = true
	for i < _SEC_SIZE, j < _SEC_SIZE do
		var tile = sector.data[i, j]
		if tile isnt null then emptyFlag = false end
	end
	if emptyFlag then sector.emptyFlag = true end
	if sector.emptyFlag && !sector.memFlag then grid.sectors[tsx, tsy] = null end
end

fn delete(EndlessGrid[T] grid, Int x, Int y)
	var (sector, _, _) = grid.lookupSector(adiv(x, _SEC_SIZE), adiv(y, _SEC_SIZE))
	if sector is null then return end
	sector.data[amod(x, _SEC_SIZE), amod(y, _SEC_SIZE)] = null
	sector.dirtyFlag = true
end



