fn _readJsonSector(Room room, Int sx, Int sy)
	-- load raw data
	var tag = "s_" + _serialNum(sx) + "_" + _serialNum(sy)
	var fc = newFileReader("rom/world/" + tag)
	if fc is null then panic("Could not load room sector: " + tag) end
	var sObj = fc.readJson().asDICT("sector " + tag)
	fc.close()
	-- read version string
	var ver = sObj["ver"].asSTRING("sector version")
	print("VER: " + ver)
	-- init sector
	var _data = new 2d(_SEC_SIZE, _SEC_SIZE)[~BaseTile?]
	var sector = new Sector{
		memFlag = true,
		emptyFlag = false,
		dirtyFlag = false,
		data = _data
	}
	-- read tile data
	var iData = sObj["data"].asLIST("sector data")
	if ver = "V0" then
		var iTotal = |iData| / 3
		for i < iTotal do
			var tx = iData[i * 3].asINT("tx")
			var ty = iData[i * 3 + 1].asINT("ty")
			var canonId = iData[i * 3 + 2].asINT("canon id")
			var tile = newBaseTile()
			tile.fore = ttLookup(canonId)
			sector.data[tx, ty] = tile
		end
	else
		panic("Unrecognized version string " + ver + " during load for room sector: " + tag)
	end
	-- reify
	room.data.sectors[sx - room.data.secX, sy - room.data.secY] = sector
	from i = -1 while i <= _SEC_SIZE,
		j = -1 while j <= _SEC_SIZE do
		room._reifyTile(sx * _SEC_SIZE + i, sy * _SEC_SIZE + j)
	end
end

fn load(Room room)
	-- read universe metadata
	var fc = newFileReader("rom/world/univ")
	if fc is null then return end
	var uObj = fc.readJson().asDICT("room loading")
	fc.close()
	-- start position
	room.startPos = (uObj["sx"].asINT("start pos"), uObj["sy"].asINT("start pos"))
	room.data.secX = uObj["secX"].asINT("sector left")
	room.data.secY = uObj["secY"].asINT("sector top")
	-- load sectors
	var secCoords = uObj["secCoords"].asLIST("sector coord list")
	for i < |secCoords| do
		var _sc = secCoords[i].asLIST("sector coordinates")
		room._readJsonSector(_sc[0].asINT("x coord"), _sc[1].asINT("y coord"))
	end
end

