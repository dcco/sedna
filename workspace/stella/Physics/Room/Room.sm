
struct Room{
	(Int, Int) startPos,
	EndlessGrid[BaseTile] data,
	OrderList[MoveObj] _objList,
	-- temporary lists to avoid creating new lists for iteration every frame
	1d[MoveObj] _iterList,
	1d[MoveObj] _tempList
}

fn _pushPri(MoveObj obj) Int
	return obj.pushType.i
end

fn newRoom() Room
	return new Room{
		startPos = (1, 1),
		data = newEndlessGrid(~BaseTile),
		_objList = newOrderList(|~PushType|, _pushPri),
		_iterList = new 1d[~MoveObj],
		_tempList = new 1d[~MoveObj]
	}
end

	(* - lookup functions *)

fn solid(Room room, Int x, Int y) Bool
	var tile = room.data[x, y]
	if tile isnt null then return tile.fore.i != 0 end
	return false
end

	(* - update functions *)

fn clear(Room room)
	room._objList.clear()
end

fn addObj(Room room, MoveObj obj)
	room._objList += obj
end

	(* - edit functions *)

fn _sameMat(Room room, TType tt, Int x, Int y) Bool
	var tile = room.data[x, y]
	if tile is null then return false end
	return tile.fore.i != 0
	--return tile.fore.i = tt.i
end

fn _reifyTile(Room room, Int x, Int y)
	-- check if tile exists
	var tile = room.data[x, y]
	if tile is null then return end
	-- check neighboring tiles
	var x1b = room._sameMat(tile.fore, x - 1, y)
	var x2b = room._sameMat(tile.fore, x + 1, y)
	var y1b = room._sameMat(tile.fore, x, y - 1)
	var y2b = room._sameMat(tile.fore, x, y + 1)
	-- apply rframes based on neighbors
	match tile.fore.rt
	case NoRe do
		tile.rFrame = 0
	case TopRe do
		if !x1b && !x2b || !y1b && !y2b then tile.rFrame = 0 return end
		var xf = 0
		var yf = 0
		if x1b && x2b then xf = 1 elsif x1b then xf = 2 end
		if y1b then yf = 1 end
		tile.rFrame = 1 + xf + (yf * 3)
	case FullRe do
		if !x1b && !x2b || !y1b && !y2b then tile.rFrame = 0 return end
		var xf = 0
		var yf = 0
		if x1b && x2b then xf = 1 elsif x1b then xf = 2 end
		if y1b && y2b then yf = 1 elsif y1b then yf = 2 end
		tile.rFrame = 1 + xf + (yf * 3)
	end
end

fn reify(Room room, Int x, Int y)
	room._reifyTile(x, y)
	room._reifyTile(x - 1, y)
	room._reifyTile(x + 1, y)
	room._reifyTile(x, y - 1)
	room._reifyTile(x, y + 1)
end

	(* - movement functions *)

fn _diffTile((Int, Int) moveRange, Axis axis, Int delta, Int tx, Int ty) (Int, Int)
	match axis case XA do
		return moveRange.diff((fromTile(tx), fromTile(tx + 1)), delta)
	owise
		return moveRange.diff((fromTile(ty), fromTile(ty + 1)), delta)
	end
end

fn canTouch(MoveObj obj, MoveObj otherObj, Rect moveBox) Bool
	var intersectFlag = obj.hitBox.overlaps(otherObj.hitBox)
	return obj.oid != otherObj.oid && moveBox.overlaps(otherObj.hitBox) && !intersectFlag
end

fn calcPush(Room room, MoveObj obj, Axis axis, Int delta, PushType pushType) Int
	var hitBox = obj.hitBox
	var moveRange = hitBox.rangeI(axis).extend(delta)
	var moveBox = hitBox.copy().setRange(axis, moveRange)
	-- reduce movement based on tiles
	from i = toTile(moveBox.x) while i <= toTile(moveBox.right() - 1),
		j = toTile(moveBox.y) while j <= toTile(moveBox.bottom() - 1) do
		if room.solid(i, j) then
			moveRange = moveRange._diffTile(axis, delta, i, j)
		end
	end
	-- check objects
	var touchList = room._objList.flatten(room._tempList)
	for i < |touchList| do
		var otherObj = touchList[i]
		if obj.canTouch(otherObj, moveBox) then
			var pushDelta = moveRange.diffDelta(otherObj.hitBox.rangeI(axis), delta)
			var retDelta = 0
			if pushDelta != 0 && pushType.i > otherObj.pushType.i then
				var retDelta = room.calcPush(otherObj, axis, pushDelta, pushType)
			end
			moveRange = moveRange.sub(pushDelta - retDelta)
		end
	end
	-- return final delta
	if delta > 0 then return moveRange.size() end
	return -moveRange.size()
end

fn push(Room room, MoveObj obj, Axis axis, Int delta, PushType pushType)
	var hitBox = obj.hitBox
	-- move other objects
	var moveRange = hitBox.rangeI(axis).extend(delta)
	var moveBox = hitBox.copy().setRange(axis, moveRange)
	var touchList = room._objList.flatten(room._tempList)
	for i < |touchList| do
		var otherObj = touchList[i]
		if obj.canTouch(otherObj, moveBox) then
			var pushDelta = moveRange.diffDelta(otherObj.hitBox.rangeI(axis), delta)
			if pushDelta != 0 && pushType.i > otherObj.pushType.i then
				room.push(otherObj, axis, pushDelta, pushType)
			end
		end
	end
	-- move object
	match axis case XA do
		hitBox.x = hitBox.x + delta
	owise
		hitBox.y = hitBox.y + delta
	end
end

fn moveObj(Room room, MoveObj obj, Axis axis, Int delta) Int
	var pushDelta = room.calcPush(obj, axis, delta, obj.pushType)
	room.push(obj, axis, pushDelta, obj.pushType)
	return pushDelta
end

const _WALL_SET = new 1d[(XA, -1), (XA, 1), (YA, -1), (YA, 1)]

fn _update(WallTrack[MoveObj] wall, Room room, MoveObj obj)
	var hitBox = obj.hitBox
	for ix < 4 do
		var (axis, delta) = _WALL_SET[ix]
		var checkRange = hitBox.rangeI(axis).extend(delta)
		var checkBox = hitBox.copy().setRange(axis, checkRange)
		-- check tiles
		from i = toTile(checkBox.x) while i <= toTile(checkBox.right() - 1),
			j = toTile(checkBox.y) while j <= toTile(checkBox.bottom() - 1) do
			if room.solid(i, j) then
				wall.setFlag(axis, delta)
			end
		end
		-- check objects
		var touchList = room._objList.flatten(room._tempList)
		for i < |touchList| do
			var otherObj = touchList[i]
			if obj.canTouch(otherObj, checkBox) then
				wall.setFlag(axis, delta)
				if obj.pushType.i < otherObj.pushType.i then
					if axis.i = YA.i && delta = 1 then wall.standObj = otherObj end 
				end
			end
		end
	end
end

fn updateObj(Room room, MoveObj obj)
	-- if standing on object, calc its movements
	var standXspd = 0
	var standObj = obj.wall.standObj
	if standObj isnt null then
		standXspd = standObj.lastXdelta
	end
	-- reset wall flags, prep metadata
	obj.wall.reset()
	var oldX = obj.hitBox.x
	-- perform movement
	var newXspd = room.moveObj(obj, XA, obj.xspd + standXspd) - standXspd
	var newYspd = room.moveObj(obj, YA, obj.yspd)
	-- update wall flags, record metadata
	obj.wall._update(room, obj)
	if newXspd != obj.xspd || newYspd != obj.yspd then obj.wall.obstruct = true end
	obj.lastXdelta = fromPixel(toPixel(obj.hitBox.x) - toPixel(oldX))
	-- update speed
	obj.xspd = newXspd
	obj.yspd = newYspd
end

fn update(Room room)
	var curList = room._objList.flattenRev(room._iterList)
	for i < |curList| do
		var obj = curList[i]
		obj.updateSpd()
		room.updateObj(obj)
	end
end

	(* - display functions *)

fn draw(Room room, Camera cam, Fn(Int, Int, Int) drawObj)
	-- get start pos
	var (sx, sy) = room.startPos
	-- draw dimensions
	var tx = pixelTile(cam.x)
	var ty = pixelTile(cam.y)
	var cw = pixelTile(cam.canvasWidth) + 1
	var ch = pixelTile(cam.canvasHeight) + 1
	-- get image data
	var tset = lookupSprite(Tset)
	if tset is null then return end
	-- iterate through tile
	for i < cw, j < ch do
		var cx = tx + i
		var cy = ty + j
		var tile = room.data[cx, cy]
		if tile isnt null then
			tile.draw(tset, tilePixel(cx), tilePixel(cy))
			drawObj(tile.obj, tilePixel(cx), tilePixel(cy))
		end
	end
	drawSprite(tilePixel(sx), tilePixel(sy), tset, 0, false)
end