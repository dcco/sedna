fn _serialNum(Int i) String
	if i < 0 then return "m" + toString(-i)
	else return toString(i) end
end

fn _serialSector(2d[BaseTile?] sector) 1d[Int]
	var iData = new 1d[~Int]
	for i < _SEC_SIZE, j < _SEC_SIZE do
		var tile = sector[i, j]
		if tile isnt null then
			iData += i
			iData += j
			iData += toInt(tile.fore.canonId)
		end
	end
	return iData
end

fn _serial(EndlessGrid[BaseTile] grid, 1d[(String, SerialObj)] serList)
	var (sw, sh) = |grid.sectors|
	for i < sw, j < sh do
		var sector = grid.sectors[i, j]
		if sector isnt null then
			-- version data
			var p1 = stringSerial("V0")
			-- sector data
			var p2 = intsSerial(sector.data._serialSector())
			-- final write
			var tag = "s_" + _serialNum(i + grid.secX) + "_" + _serialNum(j + grid.secY)
			serList += (tag, listSerial(new 1d[p1, p2]))
		end
	end
end

fn _serialSecCoords(Room room, 1d[Int] iData)
	var (sw, sh) = |room.data.sectors|
	var jData = new 1d[~Int]
	for i < sw, j < sh do
		var sector = room.data.sectors[i, j]
		if sector isnt null then
			jData += i + room.data.secX
			jData += j + room.data.secY
		end
	end
	iData += |jData| / 2
	for i < |jData| do
		iData += jData[i]
	end
end

fn serial(Room room) 1d[(String, SerialObj)]
	var serList = new 1d[~(String, SerialObj)]
	-- general universe metadata
	var (sx, sy) = room.startPos
	var iData = new 1d[sx, sy, room.data.secX, room.data.secY]
	room._serialSecCoords(iData)
	serList += ("univ", intsSerial(iData))
	-- serialize the endless grid
	room.data._serial(serList)
	return serList
end

fn save(Room room)
	var serList = room.serial()
	for i < |serList| do
		var (fName, data) = serList[i]
		var fc = newFileWriter("rom/world/" + fName, false)
		if fc isnt null then
			fc.writeSerial(data)
			fc.close()
		end
	end
end*)

