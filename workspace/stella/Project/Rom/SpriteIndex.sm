
enum SheetDef attrs{ String name } =
	TextSh{ "text" }
	| TsetSh{ "tset" }
	| MainSh{ "x1" }

enum SpriteDef attrs{ String name, SheetDef sheet, (Int, Int) tPos, (Int, Int) tSize, Int span } =
	TextSp{ "basic font", TextSh, (0, 0), (1, 1), 13 }
	| Tset{ "tileset", TsetSh, (0, 0), (1, 1), 20 }
		-- editor tilesets
	| Oset{ "object set", TsetSh, (0, 20), (1, 1), 20 }
	| Toolset{ "toolset", TsetSh, (0, 30), (1, 1), 20 }
	| DraftTset{ "map draft icons", TsetSh, (0, 40), (1, 1), 20 }
		-- object sprites
	| MaySp{ "may", MainSh, (0, 0), (2, 2), 20 }
	| BigBoxSp{ "big box (test)", MainSh, (0, 2), (2, 2), 2 }
	| BoxSp{ "box (test)", MainSh, (2, 2), (1, 1), 2 }

struct SpriteRef{
	SpriteDef sDef,
	Int frame
}
