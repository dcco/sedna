
	(* vertex data *)

struct Vertex{
	(Float, Float, Float) pos,
	(Float, Float) uv,
	(Float, Float, Float) norm
}

	(* size in memory *)
const _VERTEX_SIZET = 4 * 8

fn triNorm(Vertex v1, Vertex v2, Vertex v3) (Float, Float, Float)
	(* 0,1,2  3,4,5  6,7,8 *)
	var a0 = v3.pos.1 - v1.pos.1
	var a1 = v3.pos.2 - v1.pos.2
	var a2 = v3.pos.3 - v1.pos.3
	var b0 = v2.pos.1 - v1.pos.1
	var b1 = v2.pos.2 - v1.pos.2
	var b2 = v2.pos.3 - v1.pos.3
	-- normnalize
	var n0 = a1 * b2 - a2 * b1
	var n1 = a2 * b0 - a0 * b2
	var n2 = a0 * b1 - a1 * b0
	var mag = sqrt(n0 * n0 + n1 * n1 + n2 * n2)
	return (n0 /. mag, n1 /. mag, n2 /. mag)
end

const _SQUARE_TEX_COORDS = new 1d[
	0.0001, 0.0001, 0.9999, 0.9999, 0.9999, 0.0001,
	0.0001, 0.0001, 0.0001, 0.9999, 0.9999, 0.9999
]

fn squareZVertices(Float l, Float t, Float w, Float h, Float z) 1d[Float]
	var r = l + w
	var b = t + h
	return new 1d[
		l, t, z,
		r, b, z,
		r, l, z,
		l, t, z,
		l, b, z,
		r, b, z
	]
end