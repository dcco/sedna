
struct RenderData{
	Int total,
	1d[U8] data
}

fn newRenderData() RenderData
	return new RenderData{
		total = 0,
		data = new 1d[~U8]
	}
end

fn clear(RenderData rd)
	rd.total = 0
	rd.data.flush()
end

fn addBox(RenderData rd, U32 c, Int x, Int y, Int w, Int h)
	-- POS
	rd.data.addFloat(toFloat(x))
	rd.data.addFloat(toFloat(y))
	-- * z-sorted by draw order
	rd.data.addFloat(toFloat(-rd.total))
	-- SIZE
	rd.data.addFloat(toFloat(w))
	rd.data.addFloat(toFloat(h))
	-- COLOR
	rd.data.addU32(c)
	-- TEXID
	rd.data.addU32(_0)
	-- TEX POS
	rd.data.addFloat(0.0)
	rd.data.addFloat(0.0)
	-- TEX SIZE
	rd.data.addFloat(1.0)
	rd.data.addFloat(1.0)
	rd.total = rd.total + 1
end