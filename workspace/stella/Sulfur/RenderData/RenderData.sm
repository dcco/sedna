
struct RenderData{
	Int total,
	1d[U8] data
}

fn newRenderData() RenderData
	return new RenderData{
		total = 0,
		data = new 1d[~U8]
	}
end

fn clear(RenderData rd)
	rd.total = 0
	rd.data.flush()
end

fn addBox(RenderData rd, U32 c, Int x, Int y, Int w, Int h)
	-- POS
	rd.data.addFloat(toFloat(x))
	rd.data.addFloat(toFloat(y))
	-- * z-sorted by draw order
	rd.data.addFloat(toFloat(-rd.total))
	-- SIZE
	rd.data.addFloat(toFloat(w))
	rd.data.addFloat(toFloat(h))
	-- COLOR
	rd.data.addU32(c)
	-- TEXID
	rd.data.addFloat(0.0)
	-- TEX POS
	rd.data.addFloat(0.0)
	rd.data.addFloat(0.0)
	-- TEX SIZE
	rd.data.addFloat(1.0)
	rd.data.addFloat(1.0)
	rd.total = rd.total + 1
end

fn addSprite(RenderData rd, Int x, Int y, Sprite sprite, Int frame, Bool facing)
	-- POS
	if !facing then
		rd.data.addFloat(toFloat(x - sprite.offX))
	else
		rd.data.addFloat(toFloat(x + sprite.offX + sprite.offWidth))
	end
	rd.data.addFloat(toFloat(y - sprite.offY))
	-- * z-sorted by draw order
	rd.data.addFloat(toFloat(-rd.total))
	-- SIZE
	if !facing then
		rd.data.addFloat(toFloat(sprite.tw))
	else
		rd.data.addFloat(-toFloat(sprite.tw))
	end
	rd.data.addFloat(toFloat(sprite.th))
	-- COLOR
	rd.data.addU32(0xFFFFFFFF)
	-- TEXID
	rd.data.addFloat(toFloat(sprite.image.layer))
	-- TEX POS
	var fx = sprite.fx + (toFloat(frame % sprite.spanWidth) * sprite.fw)
	var fy = sprite.fy + (toFloat(frame / sprite.spanWidth) * sprite.fh)
	rd.data.addFloat(fx)
	rd.data.addFloat(fy)
	-- TEX SIZE
	rd.data.addFloat(sprite.fw)
	rd.data.addFloat(sprite.fh)
	rd.total = rd.total + 1
end

fn addSpriteC(RenderData rd, U32 c, Int x, Int y, Sprite sprite, Int frame, Bool facing)
	-- POS
	if !facing then
		rd.data.addFloat(toFloat(x - sprite.offX))
	else
		rd.data.addFloat(toFloat(x + sprite.offX + sprite.offWidth))
	end
	rd.data.addFloat(toFloat(y - sprite.offY))
	-- * z-sorted by draw order
	rd.data.addFloat(toFloat(-rd.total))
	-- SIZE
	if !facing then
		rd.data.addFloat(toFloat(sprite.tw))
	else
		rd.data.addFloat(-toFloat(sprite.tw))
	end
	rd.data.addFloat(toFloat(sprite.th))
	-- COLOR
	rd.data.addU32(c)
	-- TEXID
	rd.data.addFloat(toFloat(sprite.image.layer))
	-- TEX POS
	var fx = sprite.fx + (toFloat(frame % sprite.spanWidth) * sprite.fw)
	var fy = sprite.fy + (toFloat(frame / sprite.spanWidth) * sprite.fh)
	rd.data.addFloat(fx)
	rd.data.addFloat(fy)
	-- TEX SIZE
	rd.data.addFloat(sprite.fw)
	rd.data.addFloat(sprite.fh)
	rd.total = rd.total + 1
end