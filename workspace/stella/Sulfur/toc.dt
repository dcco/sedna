
module Material
	references Sys.Os
	references OpenGL.Main
	references Commons.Core
	type Vertex
	type Mesh
	type TexArray
	type TexImage
	type Sprite
end

module Shader
	references Sys.Os
	references OpenGL.Main
	references Sulfur modules Material
	type ShaderAttrDef
	type Shader
end

module RenderData
	references Sys.Os
	references OpenGL.Main
	references Sulfur modules Material
	type RenderData
end

module Main
	references OpenGL.Main
	references Sulfur modules Material, Shader, RenderData
	type Sulfur
end

module Input
	references Sys.Os
	references GLFW.Main
	type Input
end