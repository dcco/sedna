	.globl	_sz7
	.p2align	4, 0x0
_sz7:
	.long	870
	.asciz	"#version 330\r\nprecision highp float;\r\n\r\nlayout (location = 0) in vec3 aPos;\r\nlayout (location = 1) in vec2 aTex;\r\nlayout (location = 2) in vec3 iPos;\r\nlayout (location = 3) in vec2 iSize;\r\nlayout (location = 4) in uint iColor;\r\nlayout (location = 5) in float iTexId;\r\nlayout (location = 6) in vec2 iUVPos;\r\nlayout (location = 7) in vec2 iUVSize;\r\n\r\nuniform mat4 uPMat;\r\nuniform int uTotal;\r\nout vec2 vTex;\r\nout float vTexId;\r\nout vec3 vColor;\r\n\r\nvec3 unpackRGB(uint c)\r\n{\r\n\tfloat r = float((c >> 16) & 0xFFu) / 255.0;\r\n\tfloat g = float((c >> 8) & 0xFFu) / 255.0;\r\n\tfloat b = float(c & 0xFFu) / 255.0;\r\n\treturn vec3(r, g, b);\r\n}\r\n\r\nvoid main(void) {\r\n\tvec2 pos = (aPos.xy * iSize) + iPos.xy;\r\n\tgl_Position = uPMat * vec4(pos, 0.0, 1.0);\r\n\tgl_Position.z = iPos.z;// / float(uTotal);\r\n\tvTex = (aTex * iUVSize) + iUVPos;\r\n\tvTexId = iTexId;\r\n\tvColor = unpackRGB(iColor);\r\n}\r\n"
	.zero	1

	.globl	_sz8
	.p2align	4, 0x0
_sz8:
	.long	380
	.asciz	"#version 330\r\nprecision mediump float;\r\nprecision mediump sampler2DArray;\r\n\r\nin vec2 vTex;\r\nin float vTexId;\r\nin vec3 vColor;\r\n\r\nuniform sampler2DArray uSampler;\r\nout vec4 FragColor;\r\n\r\nvoid main(void) {\r\n\tvec4 texColor = texture(uSampler, vec3(vTex, vTexId));\r\n\tif (texColor.a == 0.0) discard;\r\n\tvec3 mColor = texColor.rgb * vColor.rgb;\r\n\tFragColor = vec4(mColor, texColor.a);\r\n}"
	.zero	3

